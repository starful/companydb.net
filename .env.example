# CompanyDB — copy to `.env` and fill secrets. Never commit `.env`.

# EDINET API (Financial Services Agency)
# Issue at: https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
EDINET_API_KEY=

# Open DART API (Korea FSS)
# Issue at: https://opendart.fss.or.kr
OPENDART_API_KEY=

# Reactions (Firestore) — same pattern as okcaddie / jpcampus
REACTIONS_COLLECTION=companydb
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

